{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(www\\.|m\\.)?(instagram\\.com|youtube\\.com|youtu\\.be)/",
      "maxLength": 2048
    },
    "instructions": {
      "type": "string",
      "maxLength": 4000
    },
    "output_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "processing_profile": {
      "const": "local_baseline_v1"
    },
    "visual_processing": {
      "enum": [
        "auto",
        "disabled"
      ]
    },
    "task": {
      "const": "extract"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "url"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:savedex-extractor:request:3.0.0",
  "title": "Extraction request without external research, 3.0.0"
}
